# Variables de entorno para la aplicación Calle Segura.
# En producción usa valores propios y no publiques este archivo con secretos.

DEMO_PASSWORD=cambia-esta-clave
ALLOW_AUTO_REGISTRATION=0
PORT=5000
# Flask está detrás de Apache/XAMPP: usa la IP real del cliente en el límite de intentos.
TRUST_PROXY=1
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
# Activa esta validación solo después de ajustar los límites a la zona real.
SERVICE_AREA_ENABLED=0
SERVICE_MIN_LAT=-37.66
SERVICE_MAX_LAT=-37.57
SERVICE_MIN_LON=-73.70
SERVICE_MAX_LON=-73.60

# Solo si la API se consume desde otro origen.
CORS_ORIGINS=https://calle-segura.example
